{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicroTime",
  "version": "1.0.0",
  "identifier": "app.microtime.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MicroTime",
        "url": "index.html",
        "width": 720,
        "height": 320,
        "minWidth": 520,
        "minHeight": 320,
        "center": true,
        "visible": true,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "floating-timer",
        "title": "MicroTime — Timer",
        "url": "index.html?window=floating",
        "width": 180,
        "height": 55,
        "minWidth": 220,
        "minHeight": 58,
        "maxWidth": 220,
        "maxHeight": 58,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Short focus sessions and breaks.",
    "longDescription": "Local desktop timer for short focus sessions and breaks, with an activity heatmap and JSON backups.",
    "copyright": "Copyright © 2026 MicroTime contributors",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:microtime.db"]
    }
  }
}
